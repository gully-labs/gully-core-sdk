{
  "name": "@gullylabs/core-connect",
  "version": "0.2.0",
  "description": "MIT-licensed wallet layer for Gully Core: a thin, Gully Core-themed wrapper over RainbowKit + wagmi, plus the Gully Core chain list with probed, redundant public RPC endpoints.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./chains": {
      "types": "./dist/chains/index.d.ts",
      "import": "./dist/chains/index.js",
      "default": "./dist/chains/index.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme/index.js",
      "default": "./dist/theme/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/emit-css.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "keywords": [
    "gullycore",
    "wallet",
    "rainbowkit",
    "wagmi",
    "viem",
    "connect",
    "react",
    "defi"
  ],
  "dependencies": {
    "@gullylabs/core-sdk": "workspace:*"
  },
  "peerDependencies": {
    "@rainbow-me/rainbowkit": "^2.2.0",
    "@tanstack/react-query": "^5.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "viem": "2.x",
    "wagmi": "^2.9.0"
  },
  "devDependencies": {
    "@rainbow-me/rainbowkit": "^2.2.11",
    "@tanstack/react-query": "^5.102.8",
    "@types/node": "^22.7.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.6.0",
    "viem": "^2.56.3",
    "wagmi": "^2.19.5"
  },
  "homepage": "https://docs.gullycore.xyz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gully-labs/gully-core-sdk.git",
    "directory": "packages/connect"
  },
  "bugs": {
    "url": "https://github.com/gully-labs/gully-core-sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
