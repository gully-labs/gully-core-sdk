{
  "name": "@gullylabs/core-widgets",
  "version": "0.4.0",
  "description": "Embeddable swap, liquidity, launch and buy-alert widgets for Gully Core. Headless controllers plus drop-in styled UI, with first-class integrator fee attribution.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./headless": {
      "types": "./dist/headless.d.ts",
      "import": "./dist/headless.js",
      "default": "./dist/headless.js"
    },
    "./embed": {
      "types": "./dist/embed.d.ts",
      "import": "./dist/embed.js",
      "default": "./dist/embed.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json",
    "./gullycore-embed.js": "./dist/gullycore-embed.js",
    "./gullycore-embed.mjs": "./dist/gullycore-embed.mjs",
    "./buys.js": "./dist/buys.js",
    "./buys.mjs": "./dist/buys.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build && vite build --config vite.embed.config.ts && vite build --config vite.buys.config.ts && tsc -p tsconfig.build.json && node scripts/emit-css.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build:embed": "vite build --config vite.embed.config.ts",
    "build:buys": "vite build --config vite.buys.config.ts"
  },
  "keywords": [
    "gullycore",
    "widget",
    "swap",
    "liquidity",
    "launchpad",
    "defi",
    "embeddable",
    "react"
  ],
  "dependencies": {
    "@gullylabs/core-sdk": "workspace:*",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-tooltip": "^1.2.16"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "viem": "^2.21.0",
    "wagmi": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "wagmi": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.6.0",
    "viem": "^2.21.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.0"
  },
  "homepage": "https://docs.gullycore.xyz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gully-labs/gully-core-sdk.git",
    "directory": "packages/widgets"
  },
  "bugs": {
    "url": "https://github.com/gully-labs/gully-core-sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
