{
  "name": "@gullylabs/core-sdk",
  "version": "0.3.0",
  "description": "MIT TypeScript SDK for Gully Core on Anubis, Robinhood Chain, Base, BNB Chain, Kinetiq Elysium and Gully Chain Testnet: the deployed contract address book, pool key/id derivation, hook permission bitmaps, typed events, quotes and the Gully Core registry. Build hooks without importing GPL Solidity.",
  "license": "MIT",
  "homepage": "https://docs.gullycore.xyz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gully-labs/gully-core-sdk.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/gully-labs/gully-core-sdk/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./events": {
      "import": {
        "types": "./dist/events/index.d.ts",
        "default": "./dist/events/index.js"
      },
      "require": {
