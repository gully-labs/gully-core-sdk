        "default": "./dist/cjs/indexer/index.js"
      }
    },
    "./deployments": {
      "import": {
        "types": "./dist/deployments/index.d.ts",
        "default": "./dist/deployments/index.js"
      },
      "require": {
        "types": "./dist/cjs/deployments/index.d.ts",
        "default": "./dist/cjs/deployments/index.js"
      }
    },
    "./safe": {
      "import": {
        "types": "./dist/safe/index.d.ts",
        "default": "./dist/safe/index.js"
      },
