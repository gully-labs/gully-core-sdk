        "default": "./dist/lock/index.js"
      },
      "require": {
        "types": "./dist/cjs/lock/index.d.ts",
        "default": "./dist/cjs/lock/index.js"
      }
    },
    "./price": {
      "import": {
        "types": "./dist/price/index.d.ts",
        "default": "./dist/price/index.js"
      },
      "require": {
        "types": "./dist/cjs/price/index.d.ts",
        "default": "./dist/cjs/price/index.js"
      }
    },
    "./trust": {
      "import": {
        "types": "./dist/trust/index.d.ts",
