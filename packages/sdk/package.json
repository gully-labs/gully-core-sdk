    "./schema.graphql": "./schema.graphql",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "prompts",
    "schema.graphql",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "generate": "npm run generate:deployments && npm run generate:events && npm run generate:launchpad && npm run generate:registry && npm run generate:trading",
    "generate:events": "node scripts/generate-events.mjs",
    "generate:launchpad": "node scripts/generate-launchpad-abi.mjs",
    "generate:registry": "node scripts/generate-registry-abi.mjs",
    "generate:trading": "node scripts/generate-trading-abi.mjs",
    "generate:stockfeeds": "node scripts/generate-stock-feeds.mjs",
    "generate:deployments": "node scripts/generate-deployments.mjs",
    "generate:check": "node scripts/generate-deployments.mjs --check && node scripts/generate-events.mjs --check && node scripts/generate-launchpad-abi.mjs --check && node scripts/generate-registry-abi.mjs --check && node scripts/generate-trading-abi.mjs --check",
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.cjs.json && node -e \"require('node:fs').writeFileSync('dist/cjs/package.json', JSON.stringify({ type: 'commonjs' }) + String.fromCharCode(10))\"",
    "build:generate": "npm run generate && npm run build:ci",
    "build:ci": "tsc -p tsconfig.build.json && tsc -p tsconfig.cjs.json && node -e \"require('node:fs').writeFileSync('dist/cjs/package.json', JSON.stringify({ type: 'commonjs' }) + String.fromCharCode(10))\"",
    "prepack": "npm run clean && npm run build:ci",
    "prepublishOnly": "npm run generate:check && npm run build && npm test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "generate:nativefeeds": "node scripts/generate-native-feeds.mjs",
    "sync-check": "node scripts/sync-check.mjs"
  },
  "keywords": [
    "gullycore",
    "amm",
    "hooks",
    "defi",
    "ethereum",
    "sdk",
    "typescript",
    "viem",
    "concentrated-liquidity",
    "dex",
    "launchpad",
    "gully-chain",
    "anubis"
  ],
  "dependencies": {
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "blockstore-core": "^7.0.1",
    "ipfs-unixfs-importer": "^17.1.1",
    "multiformats": "^14.0.5",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "author": "Gully Labs (https://gullylabs.xyz)"
}
