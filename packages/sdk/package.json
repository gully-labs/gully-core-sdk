        "default": "./dist/cjs/safe/index.js"
      }
    },
    "./registry": {
      "import": {
        "types": "./dist/registry/index.d.ts",
        "default": "./dist/registry/index.js"
      },
      "require": {
        "types": "./dist/cjs/registry/index.d.ts",
        "default": "./dist/cjs/registry/index.js"
      }
    },
    "./launchpad": {
      "import": {
        "types": "./dist/launchpad/index.d.ts",
        "default": "./dist/launchpad/index.js"
      },
      "require": {
        "types": "./dist/cjs/launchpad/index.d.ts",
        "default": "./dist/cjs/launchpad/index.js"
      }
    },
    "./split": {
      "import": {
        "types": "./dist/split/index.d.ts",
        "default": "./dist/split/index.js"
      },
      "require": {
